{
  "nptel-catalog-validator": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/post-edit-verify.mjs",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "nptel-production-safety-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/pre-command-guard.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
